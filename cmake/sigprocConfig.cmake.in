@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Hard system dependencies required by every sigproc build.
find_dependency(OpenMP)
find_dependency(HDF5)

# Static sigproc archives reference FFTW symbols; shared builds bundle FFTW privately.
if(NOT @SIGPROC_BUILT_AS_SHARED@)
  find_dependency(FFTW COMPONENTS FLOAT_LIB)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/sigprocTargets.cmake")

get_target_property(sigproc_INCLUDE_DIRS sigproc::sigproc INTERFACE_INCLUDE_DIRECTORIES)
set(sigproc_LIBRARIES sigproc::sigproc)
set(sigproc_FOUND TRUE)

check_required_components(sigproc)

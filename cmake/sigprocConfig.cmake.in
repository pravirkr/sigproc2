@PACKAGE_INIT@

# sigproc CMake configuration file

# Find required dependencies
include(CMakeFindDependencyMacro)

# Find system dependencies required by sigproc
find_dependency(OpenMP REQUIRED)

# Find FFTW - use COMPONENTS if your FindFFTW.cmake supports it
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(FFTW REQUIRED)

# Find spdlog (header-only, PUBLIC dependency)
find_dependency(spdlog REQUIRED)

# Note: scn is PRIVATE, so consumers don't need to find it

# Set up imported targets
include("${CMAKE_CURRENT_LIST_DIR}/sigprocTargets.cmake")

# Provide legacy variables for compatibility
get_target_property(sigproc_INCLUDE_DIRS sigproc::sigproc INTERFACE_INCLUDE_DIRECTORIES)
set(sigproc_LIBRARIES sigproc::sigproc)
set(sigproc_FOUND TRUE)

check_required_components(sigproc)